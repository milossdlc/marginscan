{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"marginscan",
 "main":"platform/worker.ts",
 "compatibility_date":"2026-09-13",
 "compatibility_flags":["nodejs_compat"],
 "workers_dev":true,
 "assets":{"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
 "d1_databases":[{"binding":"DB","database_name":"marginscan-db","database_id":"5b52c427-1d9f-48d1-9b3f-6ce02e28df7f","migrations_dir":"migrations"}],
 "triggers":{"crons":["*/5 * * * *"]},
 "vars":{"COLLECTOR_ENABLED":"false","ACCESS_TEAM_DOMAIN":"","ACCESS_AUD":""},
 "observability":{"enabled":true}
}
