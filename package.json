{
  "name": "marginscan",
  "private": true,
  "version": "0.1.0-alpha.rc1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler d1 migrations apply marginscan-db --remote && wrangler deploy --keep-vars",
    "check": "tsc --noEmit -p tsconfig.worker.json && tsc --noEmit --noUnusedLocals false --noUnusedParameters false",
    "types": "wrangler types",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "miniflare": "^5.20260911.0-alpha",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.131.1"
  }
}
